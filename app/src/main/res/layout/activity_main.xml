<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/btnPickApk"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="#1E1E1E"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📁  "
                android:textSize="24sp"/>
            <TextView
                android:id="@+id/tvApkName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="בחר קובץ APK"
                android:textColor="#00F5C4"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="כותרת *" android:textColor="#AAAAAA" android:textSize="12sp"
            android:layout_gravity="end" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/etTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="#1E1E1E" android:textColor="#FFFFFF"
            android:textColorHint="#555555" android:padding="12dp"
            android:gravity="end" android:inputType="text"
            android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="הודעה *" android:textColor="#AAAAAA" android:textSize="12sp"
            android:layout_gravity="end" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/etMessage"
            android:layout_width="match_parent" android:layout_height="100dp"
            android:background="#1E1E1E" android:textColor="#FFFFFF"
            android:textColorHint="#555555" android:padding="12dp"
            android:gravity="end|top" android:inputType="textMultiLine"
            android:hint="הכנס את תוכן ההודעה...."
            android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="טקסט כפתור אישור" android:textColor="#AAAAAA" android:textSize="12sp"
            android:layout_gravity="end" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/etButtonText"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="#1E1E1E" android:textColor="#FFFFFF"
            android:padding="12dp" android:gravity="end"
            android:text="אישור" android:inputType="text"
            android:layout_marginBottom="16dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="end"
            android:layout_marginBottom="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="אופציונלי" android:textColor="#555555" android:textSize="10sp"
                android:layout_marginEnd="8dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="קישור טלגרם / וואטסאפ" android:textColor="#AAAAAA" android:textSize="12sp"/>
        </LinearLayout>
        <EditText android:id="@+id/etTelegramLink"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="#1E1E1E" android:textColor="#FFFFFF"
            android:textColorHint="#555555" android:padding="12dp"
            android:gravity="end" android:inputType="textUri"
            android:hint="https://t.me/mychannel"
            android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="מזהה ייחודי (Pref Key)" android:textColor="#AAAAAA" android:textSize="12sp"
            android:layout_gravity="end" android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/etPrefKey"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="#1E1E1E" android:textColor="#FFFFFF"
            android:padding="12dp" android:gravity="end"
            android:text="my_dialog_v1" android:inputType="text"
            android:layout_marginBottom="4dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="שנה מספר בין גרסאות כדי להציג שוב"
            android:textColor="#555555" android:textSize="10sp"
            android:layout_gravity="end" android:layout_marginBottom="24dp"/>

        <TextView android:id="@+id/btnInject"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="הזרק דיאלוג ⚡"
            android:textColor="#00F5C4" android:textSize="22sp" android:textStyle="bold"
            android:layout_gravity="center" android:layout_marginBottom="24dp"
            android:padding="8dp"/>

        <Button android:id="@+id/btnDelete"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:text="מחק דיאלוגים קיימים 🗑"
            android:textColor="#FF6B6B" android:textSize="16sp"
            android:backgroundTint="#00F5C4"
            android:layout_marginBottom="16dp"/>

        <LinearLayout android:id="@+id/logContainer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E" android:padding="12dp"
            android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="end"
                android:layout_marginBottom="8dp">
                <TextView android:id="@+id/tvLogStatus"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#00F5C4" android:textSize="14sp" android:textStyle="bold"/>
                <ProgressBar android:id="@+id/progressLog"
                    android:layout_width="20dp" android:layout_height="20dp"
                    android:layout_marginStart="8dp" android:visibility="gone"/>
            </LinearLayout>
            <TextView android:id="@+id/tvLog"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#CCCCCC" android:textSize="11sp"
                android:fontFamily="monospace" android:gravity="end"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
